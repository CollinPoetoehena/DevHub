# {{ ansible_managed }}
# ===========================================================================
# Ansible Inventory File (INI format) — AUTO-GENERATED
# ===========================================================================
# Generated by: ansible-playbook setup_local_env.yml
# Template:     templates/hosts.j2
# Variables:    vars/setup_local_env.yml
#
# DO NOT EDIT MANUALLY — re-run the setup playbook to regenerate.
# To add new hosts or change IPs, update vars/setup_local_env.yml
# (inventory_hosts section) and re-run: ansible-playbook setup_local_env.yml
#
# This file defines all hosts in the homelab infrastructure grouped by role.
# Ansible uses these groups to target specific plays in site.yml.
#
# Format per host entry:
#   <alias>    ansible_host=<ip>
#   - alias: human-readable name used in Ansible output and --limit flags
#   - ansible_host: the actual IP address Ansible connects to via SSH
#
# Network layout (from homelab/docs/2_Network/2_1_Network_Setup.md):
#   Home network:   192.168.2.0/24 (ISP modem)
#   Lab network:    10.42.0.0/20   (Pi router)
#   VLAN 10 Mgmt:   10.42.10.0/24
#   VLAN 20 Mon:    10.42.20.0/24
#   VLAN 30 K8s:    10.42.30.0/24
# ===========================================================================

# ---------------------------------------------------------------------------
# Lab Router (Raspberry Pi)
# ---------------------------------------------------------------------------
# Connected via WAN IP (eth0) from the home network.
# eth1 (LAN) serves the lab network at {{ router_lan_ip | default('10.42.0.1') }}.
[router]
{% if inventory_hosts.router is defined and inventory_hosts.router | length > 0 %}
{% for host in inventory_hosts.router %}
{{ host.alias }}    ansible_host={{ host.ip }}
{% endfor %}
{% else %}
# No router hosts configured yet
{% endif %}

