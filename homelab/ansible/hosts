# Ansible Inventory File (INI format)
# ===========================================================================
# This file defines all hosts in the homelab infrastructure grouped by role.
# Ansible uses these groups to target specific plays in site.yml.
#
# ALL INFORMATION BELOW COMES FROM homelab/docs/2_Network/2_2_Network_Setup.md
#
# How to find a host's IP:
#   - Router (Pi): check ISP modem admin page or run `hostname -I` on the Pi
#   - Lab devices: check the router's DHCP leases or run `ip a` on the device
#
# After VLANs are configured, update IPs to match the VLAN subnets:
#   VLAN 10 Management:  10.42.10.0/24
#   VLAN 20 Monitoring:  10.42.20.0/24
#   VLAN 30 Kubernetes:  10.42.30.0/24
#
# SSH key: all hosts use the ansibleremote user (created by the bootstrap play)
# with the key specified in group_vars/all/users.yml.
# ===========================================================================

# ---------------------------------------------------------------------------
# Lab Router (Raspberry Pi)
# ---------------------------------------------------------------------------
# The Pi has two interfaces:
#   eth0 (WAN): 192.168.2.x — on the home network (DHCP from ISP modem)
#   eth1 (LAN): 10.42.0.1   — gateway for the lab network (static)
#
# We connect to the Pi via its WAN IP (eth0) from the home network since
# the Ansible controller (your laptop) sits on the home network alongside
# the ISP modem. Once VLANs are set up, the management VLAN IP can be used.
[router]
lab-router    ansible_host=192.168.2.59

